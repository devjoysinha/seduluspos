# Contact form -> Resend (https://resend.com). Copy to .env.local for local dev.
# On the server these go in /home/ubuntu/seduluspos/.env, which docker compose
# passes into the container. Never commit real values.

# Resend API key; "Sending access" is enough (https://resend.com/api-keys).
RESEND_API_KEY=
# Where leads are emailed; comma-separate several addresses. It must be a real
# mailbox: Resend accepting a send is not delivery, and a bounce is only visible
# in the Resend dashboard. (hello@sedulus.in has no mailbox and bounces.)
CONTACT_TO_EMAIL=joysinha@sedulus.in
# Sender; must be on a domain verified in Resend (sedulus.in is). Without one,
# use "Sedulus Website <onboarding@resend.dev>", which only reaches the Resend
# account's own address.
CONTACT_FROM_EMAIL="Sedulus Website <leads@sedulus.in>"
